rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function hasActiveProfile() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isActive == true;
    }

    function isEditorOrAdmin() {
      return hasActiveProfile()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'editor'];
    }

    match /products/{productId}/{imageName} {
      allow read: if hasActiveProfile();
      allow write: if isEditorOrAdmin()
        && (request.resource == null
          || (request.resource.size < 5 * 1024 * 1024
            && request.resource.contentType.matches('image/(jpeg|png|webp)')));
    }
  }
}
